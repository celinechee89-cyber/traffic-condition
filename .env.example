# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LTA_ACCOUNT_KEY: API Key from LTA DataMall (https://datamall.lta.gov.sg)
# Configured in Vercel Environment Variables:
LTA_ACCOUNT_KEY="YOUR_LTA_ACCOUNT_KEY"

# ONEMAP_ACCOUNT_KEY: API Key / Authorization Token from OneMap Singapore (https://www.onemap.gov.sg/apidocs/)
# Configured in Vercel Environment Variables:
ONEMAP_ACCOUNT_KEY="YOUR_ONEMAP_ACCOUNT_KEY"
